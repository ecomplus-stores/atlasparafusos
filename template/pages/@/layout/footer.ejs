<%
// load footer options and contacts from content

const footer = _.cms('footer') || {}
const contacts = _.cms('contacts') || {}
const themeCustom = _.settings.theme.custom || ''
%>

<footer class="footer py-4 py-lg-5">
  <div class="container">

    <!-- Top section: 4 columns -->
    <div class="row footer__top pb-4">

      <!-- Column 1: Logo + Description + Social + Pagamentos + Selos -->
      <div class="col-12 col-lg-4 mb-4 mb-lg-0 footer__brand-col">
        <a href="/" class="footer__logo-link d-block mb-3">
          <%- await include('@/layout/inc/logo', { _ }) %>
        </a>
        <% if (footer.description.text || _.settings.description) { %>
          <p class="footer__description">
            <%- footer.description.text || _.settings.description %>
          </p>
        <% } %>
        <% if (footer.contacts.socials) { %>
          <p class="footer__social mb-0 mt-3">
            <%- await include('@/layout/inc/networks', { _, contacts }) %>
          </p>
        <% } %>
        <hr>
        <p class="footer__payment-methods mb-2">
          <% Object.keys(footer.payment_methods).forEach(method => { %>
            <% if (footer.payment_methods[method]) { %>
              <i class="pay-icon pay-icon--<%= method %>"></i>
            <% } %>
          <% }) %>
        </p>
        <div class="footer__stamps">
          <%- await include(`@/sections/stamps`, { _, opt: { stamps: footer.stamps } }) %>
        </div>
      </div>

      <!-- Column 2: Links 1 (Páginas) -->
      <% if (footer.links_1.list_pages || footer.links_1.list.find(({ url }) => url)) { %>
        <div class="col-12 col-sm-6 col-lg mb-4 mb-lg-0">
          <div class="footer__title">
            <%= footer.links_1.title || _.dictionary('pages') %>
          </div>
          <% if (footer.links_1.list_pages) { %>
            <ul class="footer__links">
              <% (_.cms('pages') || []).forEach(slug => { %>
                <% const { title } = _.cms(`pages/${slug}`) %>
                <li>
                  <a href="/pages/<%= slug %>"><%= title %></a>
                </li>
              <% }) %>
            </ul>
          <% } else { %>
            <ul class="footer__links">
              <% footer.links_1.list.forEach(({ url, text }) => { %>
                <li>
                  <a href="<%= url %>"><%= text %></a>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </div>
      <% } %>

      <!-- Column 3: Links 2 (Categorias) -->
      <% if (footer.links_2.list_categories || footer.links_2.list.find(({ url }) => url)) { %>
        <div class="col-12 col-sm-6 col-lg mb-4 mb-lg-0">
          <div class="footer__title">
            <%= footer.links_2.title || _.dictionary('categories') %>
          </div>
          <% if (footer.links_2.list_categories) { %>
            <ul class="footer__links">
              <% _.categories.forEach(({ name, slug, parent }) => { %>
                <% if (!parent) { %>
                  <li>
                    <a href="/<%= slug %>"><%= name %></a>
                  </li>
                <% } %>
              <% }) %>
            </ul>
          <% } else { %>
            <ul class="footer__links">
              <% footer.links_2.list.forEach(({ url, text }) => { %>
                <li>
                  <a href="<%= url %>"><%= text %></a>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </div>
      <% } %>

      <!-- Column 4: Contacts -->
      <div class="col-12 col-sm-6 col-lg mb-4 mb-lg-0">
        <div class="footer__contacts">
          <% if (footer.contacts.title) { %>
            <div class="footer__title"><%= footer.contacts.title %></div>
          <% } %>
          <ul class="list-unstyled footer__contact-list">
            <% if (footer.contacts.phone_wpp) { %>
              <% if (contacts.whatsapp) { %>
                <li>
                  <span class="footer__list-icon"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="#d41217" viewBox="0 0 256 256"><path d="M187.58,144.84l-32-16a8,8,0,0,0-8,.5l-14.69,9.8a40.55,40.55,0,0,1-16-16l9.8-14.69a8,8,0,0,0,.5-8l-16-32A8,8,0,0,0,104,64a40,40,0,0,0-40,40,88.1,88.1,0,0,0,88,88,40,40,0,0,0,40-40A8,8,0,0,0,187.58,144.84ZM152,176a72.08,72.08,0,0,1-72-72A24,24,0,0,1,99.29,80.46l11.48,23L101,118a8,8,0,0,0-.73,7.51,56.47,56.47,0,0,0,30.15,30.15A8,8,0,0,0,138,155l14.61-9.74,23,11.48A24,24,0,0,1,152,176ZM128,24A104,104,0,0,0,36.18,176.88L24.83,210.93a16,16,0,0,0,20.24,20.24l34.05-11.35A104,104,0,1,0,128,24Zm0,192a87.87,87.87,0,0,1-44.06-11.81,8,8,0,0,0-6.54-.67L40,216,52.47,178.6a8,8,0,0,0-.66-6.54A88,88,0,1,1,128,216Z"></path></svg></span>
                  <a
                    href="javascript:;"
                    target="_blank"
                    rel="noopener"
                    class="whatsapp-link"
                    data-tel="<%= contacts.whatsapp.replace(/\D/g, '') %>"
                  >
                    <%= contacts.whatsapp %>
                  </a>
                </li>
              <% } %>
              <% if (contacts.phone) { %>
                <li>
                  <span class="footer__list-icon"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="#d41217" viewBox="0 0 256 256"><path d="M144.27,45.93a8,8,0,0,1,9.8-5.66,86.22,86.22,0,0,1,61.66,61.66,8,8,0,0,1-5.66,9.8A8.23,8.23,0,0,1,208,112a8,8,0,0,1-7.73-5.94,70.35,70.35,0,0,0-50.33-50.33A8,8,0,0,1,144.27,45.93Zm-2.33,41.8c13.79,3.68,22.65,12.54,26.33,26.33A8,8,0,0,0,176,120a8.23,8.23,0,0,0,2.07-.27,8,8,0,0,0,5.66-9.8c-5.12-19.16-18.5-32.54-37.66-37.66a8,8,0,1,0-4.13,15.46Zm81.94,95.35A56.26,56.26,0,0,1,168,232C88.6,232,24,167.4,24,88A56.26,56.26,0,0,1,72.92,32.12a16,16,0,0,1,16.62,9.52l21.12,47.15,0,.12A16,16,0,0,1,109.39,104c-.18.27-.37.52-.57.77L88,129.45c7.49,15.22,23.41,31,38.83,38.51l24.34-20.71a8.12,8.12,0,0,1,.75-.56,16,16,0,0,1,15.17-1.4l.13.06,47.11,21.11A16,16,0,0,1,223.88,183.08Zm-15.88-2s-.07,0-.11,0h0l-47-21.05-24.35,20.71a8.44,8.44,0,0,1-.74.56,16,16,0,0,1-15.75,1.14c-18.73-9.05-37.4-27.58-46.46-46.11a16,16,0,0,1,1-15.7,6.13,6.13,0,0,1,.57-.77L96,95.15l-21-47a.61.61,0,0,1,0-.12A40.2,40.2,0,0,0,40,88,128.14,128.14,0,0,0,168,216,40.21,40.21,0,0,0,208,181.07Z"></path></svg></span>
                  <a href="tel:+<%= contacts.phone.replace(/\D/g, '') %>" target="_blank" rel="noopener">
                    <%= contacts.phone %>
                  </a>
                </li>
              <% } %>
            <% } %>
            <% if (footer.contacts.email) { %>
              <li>
                <span class="footer__list-icon"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="#d41217" viewBox="0 0 256 256"><path d="M228.44,89.34l-96-64a8,8,0,0,0-8.88,0l-96,64A8,8,0,0,0,24,96V200a16,16,0,0,0,16,16H216a16,16,0,0,0,16-16V96A8,8,0,0,0,228.44,89.34ZM96.72,152,40,192V111.53Zm16.37,8h29.82l56.63,40H56.46Zm46.19-8L216,111.53V192ZM128,41.61l81.91,54.61-67,47.78H113.11l-67-47.78Z"></path></svg></span>
                <a href="mailto:<%= contacts.email %>" target="_blank" rel="noopener">
                  <%= contacts.email %>
                </a>
              </li>
            <% } %>
            <% if (footer.contacts.address) { %>
              <li>
                <span class="footer__list-icon"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="#d41217" viewBox="0 0 256 256"><path d="M112,80a16,16,0,1,1,16,16A16,16,0,0,1,112,80ZM64,80a64,64,0,0,1,128,0c0,59.95-57.58,93.54-60,94.95a8,8,0,0,1-7.94,0C121.58,173.54,64,140,64,80Zm16,0c0,42.2,35.84,70.21,48,78.5,12.15-8.28,48-36.3,48-78.5a48,48,0,0,0-96,0Zm122.77,67.63a8,8,0,0,0-5.54,15C213.74,168.74,224,176.92,224,184c0,13.36-36.52,32-96,32s-96-18.64-96-32c0-7.08,10.26-15.26,26.77-21.36a8,8,0,0,0-5.54-15C29.22,156.49,16,169.41,16,184c0,31.18,57.71,48,112,48s112-16.82,112-48C240,169.41,226.78,156.49,202.77,147.63Z"></path></svg></span>
                <address><%= contacts.address %></address>
              </li>
            <% } %>
          </ul>
        </div>
      </div>

    </div><!-- /.footer__top -->

    <hr class="footer__divider">

    <div class="footer__credits">
      <div class="container">
        <div class="row align-items-center justify-content-between credits">
          <div class="col-12 col-md">
            <span>
              <small>
                <%- footer.credits || `© ${_.store.name} / CNPJ: ${contacts.doc_number}` %>
              </small>
            </span>
          </div>
          <div class="col-auto"><%- await include('@/layout/inc/ecom-credits') %></div>
        </div>
      </div>      
    </div>

  </div>
</footer>


