<%
let allCategories
try {
  const { data } = await _.ecomClient.store({
    url: '/categories.json'
  })
  allCategories = data.result
} catch (err) {
  console.error(err)
}

if (Array.isArray(allCategories) && allCategories.length) {
  allCategories = allCategories.filter(cat => cat.name != "Ocultar")
  const catByParent = _.lodash.groupBy(allCategories, ({ parent }) => {
    return !parent || !parent.name ? '_' : parent.name
  })
  const rootCategories = catByParent['_'] || []
  const secId = 'ct' + Math.random().toString(36).slice(2, 7)

  const categoryLink = opt.link || '/search'
  const sectionTitle = opt.title || 'Categorias'

  // Detect current category context
  let startCategories = rootCategories
  let startParentName = null
  const onCategoryPage = _.route && _.route.resource === 'categories' && _.state && _.state.slug
  if (onCategoryPage) {
    const currentSlug = _.state.slug
    const children = catByParent[_.state.name]
    if (children && children.length) {
      startCategories = children
      startParentName = _.state.name || null
    } else {
      startCategories = []
    }
  }

  if (startCategories.length) {

  const buildCardHtml = (cat, level) => {
    const isLeaf = !catByParent[cat.name] || catByParent[cat.name].length === 0
    const initial = (cat.name || '?').charAt(0).toUpperCase()
    // deterministic hue from category _id or name
    const hue = (cat._id
      ? parseInt(cat._id.slice(-3), 16)
      : cat.name.charCodeAt(0) * 3) % 360
    const iconHtml = cat.icon
      ? `<img
            data-src="${cat.icon.url}"
            alt="${cat.icon.alt || cat.name}"
            class="lozad category-tree__icon"
          >`
      : `<div class="category-tree__placeholder" style="background:hsl(${hue},55%,50%)">${initial}</div>`
    return `<div class="col-6 col-md-4 col-lg-3 mb-2">
      <button
        class="category-tree__card d-flex align-items-center w-100"
        onclick="catTreeSelect('${secId}','${cat.slug}','${cat.name}',${level},${isLeaf})"
        type="button"
        aria-label="${cat.name}"
      >
        <span class="category-tree__img-wrap flex-shrink-0">${iconHtml}</span>
        <span class="category-tree__name">${cat.name}</span>
      </button>
    </div>`
  }
%>

<style>
  
  .category-tree .row {
    margin-left: -.25rem;
    margin-right: -.25rem;
  }
  .category-tree .row > [class*="col-"] {
    padding-left: .25rem;
    padding-right: .25rem;
  }
  .category-tree__level { animation: ctFadeIn .2s ease; }
  .category-tree__level-header {
    font-size: .8rem;
    font-weight: 600;
    color: #666;
    text-transform: uppercase;
    letter-spacing: .04em;
    margin-bottom: .4rem;
    padding-left: .25rem;
  }
  @keyframes ctFadeIn {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .category-tree__card {
    background: #f5f5f5;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: .5rem .5rem;
    cursor: pointer;
    transition: background .15s, border-color .15s;
    text-align: left;
    gap: .75rem;
  }
  .category-tree__card:hover { background: #ebebeb; }
  .category-tree__card.active {
    border-color: var(--secondary, #b80f0a);
    background: #fff;
  }
  .category-tree__img-wrap {
    width: 68px;
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .category-tree__icon {
    max-width: 68px;
    max-height: 68px;
    object-fit: contain;
    border-radius: 4px;
  }
  .category-tree__placeholder {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    font-weight: 700;
    color: #fff;
  }
  .category-tree__name {
    font-size: .9rem;
    font-weight: 500;
    line-height: 1.3;
    color: #222;
  }

  /* ── Responsive ── */
  @media (max-width: 575.98px) {
    .category-tree__card {
      padding: .25rem;
      gap:0;
      // flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .category-tree__img-wrap {
      width: 36px;
      height: 36px;
    }
    .category-tree__icon {
      max-width: 36px;
      max-height: 36px;
    }
    .category-tree__placeholder {
width: 36px;
        height: 36px;
        font-size: .7rem;
    }
    .category-tree__name {
      font-size: .7rem;
      text-align:left;
              word-break: break-word;
    }
  }

  @media (min-width: 576px) and (max-width: 767.98px) {
    .category-tree__card {
      padding: .45rem .5rem;
      gap: .6rem;
    }
    .category-tree__img-wrap {
      width: 56px;
      height: 56px;
    }
    .category-tree__icon {
      max-width: 56px;
      max-height: 56px;
    }
    .category-tree__placeholder {
      width: 56px;
      height: 56px;
      font-size: 1.4rem;
    }
  }
</style>

<div class="collection-shelf category-tree <% if (!startParentName) { %>my-lg-5 my-3<% } %>">
  <% if (!startParentName) { %>
    <h4 class="products-carousel__title mb-4">
      <% if (sectionTitle) { %>
        <span><%= sectionTitle %></span>
      <% } %>
      
    </h4>
    <% if (opt.subtitle) { %>
      <p class="text-muted mb-3"><%= opt.subtitle %></p>
    <% } %>
  <% } %>
  <div id="<%= secId %>" class="category-tree">
    <div class="category-tree__level" data-level="0">
      <% if (startParentName) { %>
        <div class="category-tree__level-header"><%= startParentName %></div>
      <% } %>
      <div class="row">
        <%- startCategories.map(cat => buildCardHtml(cat, 0)).join('') %>
      </div>
    </div>
  </div>
</div>

<script>
  window._catTree = window._catTree || {}
  window._catTree['<%= secId %>'] = <%- JSON.stringify(catByParent) %>

  function catTreeSelect (secId, slug, name, level, isLeaf) {
    if (isLeaf) {
      window.location.href = '/' + slug
      return
    }
    var container = document.getElementById(secId)
    if (!container) return

    // remove all levels deeper than current
    var levels = container.querySelectorAll('.category-tree__level')
    levels.forEach(function (el) {
      if (parseInt(el.dataset.level, 10) > level) {
        el.remove()
      }
    })

    // mark active card on current level, deactivate siblings
    var currentLevel = container.querySelector('.category-tree__level[data-level="' + level + '"]')
    if (currentLevel) {
      currentLevel.querySelectorAll('.category-tree__card').forEach(function (btn) {
        btn.classList.remove('active')
      })
      var clicked = currentLevel.querySelector('[onclick*="\'' + slug + '\'"]')
      if (clicked) clicked.classList.add('active')
    }

    var children = window._catTree[secId][name]
    if (children && children.length) {
      catTreeRender(secId, slug, name, children, level + 1)
    } else {
      window.location.href = '/' + slug
    }
  }

  function catTreeRender (secId, parentSlug, parentName, cats, level) {
    var container = document.getElementById(secId)
    if (!container) return
    var map = window._catTree[secId]

    var hslFromCat = function (cat) {
      var hue = 0
      if (cat._id) {
        hue = parseInt(cat._id.slice(-3), 16) % 360
      } else if (cat.name) {
        hue = (cat.name.charCodeAt(0) * 3) % 360
      }
      return hue
    }

    var cards = cats.map(function (cat) {
      var isLeaf = !map[cat.name] || map[cat.name].length === 0
      var initial = (cat.name || '?').charAt(0).toUpperCase()
      var hue = hslFromCat(cat)
      var iconHtml = cat.icon
        ? '<img data-src="' + cat.icon.url + '" alt="' + (cat.icon.alt || cat.name) + '" class="lozad category-tree__icon">'
        : '<div class="category-tree__placeholder" style="background:hsl(' + hue + ',55%,50%)">' + initial + '</div>'
      return '<div class="col-4 col-md-4 col-lg-3 mb-2">' +
        '<button class="category-tree__card d-flex align-items-center w-100" ' +
          'onclick="catTreeSelect(\'' + secId + '\',\'' + cat.slug + '\',\'' + cat.name + '\',' + level + ',' + isLeaf + ')" ' +
          'type="button" aria-label="' + cat.name + '">' +
          '<span class="category-tree__img-wrap flex-shrink-0">' + iconHtml + '</span>' +
          '<span class="category-tree__name">' + cat.name + '</span>' +
        '</button>' +
      '</div>'
    }).join('')

    var levelDiv = document.createElement('div')
    levelDiv.className = 'category-tree__level mt-2'
    levelDiv.dataset.level = level
    levelDiv.innerHTML =
      (parentName ? '<div class="category-tree__level-header">' + parentName + '</div>' : '') +
      '<div class="row">' + cards + '</div>'

    container.appendChild(levelDiv)

    // lazy load images in new level
    if (window.lozad) {
      lozad(levelDiv.querySelectorAll('.lozad')).observe()
    }

    // smooth scroll to the subcategory title, offset by fixed header height
    var scrollTarget = levelDiv.querySelector('.category-tree__level-header') || levelDiv
    var header = document.getElementById('header')
    var headerOffset = header ? header.offsetHeight : 0
    var targetTop = scrollTarget.getBoundingClientRect().top + window.pageYOffset - headerOffset
    window.scrollTo({ top: targetTop, behavior: 'smooth' })
  }
</script>
<% } } %>
