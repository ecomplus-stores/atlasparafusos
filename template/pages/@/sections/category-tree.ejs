<%
let allCategories
try {
  const { data } = await _.ecomClient.store({
    url: '/categories.json'
  })
  allCategories = data.result
} catch (err) {
  console.error(err)
}

if (Array.isArray(allCategories) && allCategories.length) {
  const catByParent = _.lodash.groupBy(allCategories, ({ parent }) => {
    return !parent || !parent.slug ? '_' : parent.slug
  })
  const rootCategories = catByParent['_'] || []
  const secId = 'ct' + Math.random().toString(36).slice(2, 7)

  const categoryLink = opt.link || '/search'
  const sectionTitle = opt.title || 'Categorias'

  const buildCardHtml = (cat, level) => {
    const isLeaf = !catByParent[cat.slug] || catByParent[cat.slug].length === 0
    const initial = (cat.name || '?').charAt(0).toUpperCase()
    // deterministic hue from category _id or name
    const hue = (cat._id
      ? parseInt(cat._id.slice(-3), 16)
      : cat.name.charCodeAt(0) * 3) % 360
    const iconHtml = cat.icon
      ? `<img
            data-src="${cat.icon.url}"
            alt="${cat.icon.alt || cat.name}"
            class="lozad category-tree__icon"
          >`
      : `<div class="category-tree__placeholder" style="background:hsl(${hue},55%,50%)">${initial}</div>`
    return `<div class="col-6 col-md-4 col-lg-3 mb-2">
      <button
        class="category-tree__card d-flex align-items-center w-100"
        onclick="catTreeSelect('${secId}','${cat.slug}',${level},${isLeaf})"
        type="button"
        aria-label="${cat.name}"
      >
        <span class="category-tree__img-wrap flex-shrink-0">${iconHtml}</span>
        <span class="category-tree__name">${cat.name}</span>
      </button>
    </div>`
  }
%>

<style>
  .category-tree { margin-top: .5rem; }
  .category-tree__level { animation: ctFadeIn .2s ease; }
  .category-tree__level-header {
    font-size: .8rem;
    font-weight: 600;
    color: #666;
    text-transform: uppercase;
    letter-spacing: .04em;
    margin-bottom: .4rem;
    padding-left: .25rem;
  }
  @keyframes ctFadeIn {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .category-tree__card {
    background: #f5f5f5;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: .5rem .75rem;
    cursor: pointer;
    transition: background .15s, border-color .15s;
    text-align: left;
    gap: .75rem;
  }
  .category-tree__card:hover { background: #ebebeb; }
  .category-tree__card.active {
    border-color: var(--secondary, #b80f0a);
    background: #fff;
  }
  .category-tree__img-wrap {
    width: 68px;
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .category-tree__icon {
    max-width: 68px;
    max-height: 68px;
    object-fit: contain;
  }
  .category-tree__placeholder {
    width: 68px;
    height: 68px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    font-weight: 700;
    color: #fff;
  }
  .category-tree__name {
    font-size: .9rem;
    font-weight: 500;
    line-height: 1.3;
    color: #222;
  }
</style>

<div class="collection-shelf my-lg-5">
  <h4 class="products-carousel__title">
    <% if (sectionTitle) { %>
      <span><%= sectionTitle %></span>
    <% } %>
    <a href="<%= categoryLink %>" class="products-carousel__see-all">
      <%= _.dictionary('seeAll') || 'Ver todas as categorias' %>
    </a>
  </h4>
  <% if (opt.subtitle) { %>
    <p class="text-muted mb-3"><%= opt.subtitle %></p>
  <% } %>

  <div id="<%= secId %>" class="category-tree">
    <div class="category-tree__level" data-level="0">
      <div class="row">
        <%- rootCategories.map(cat => buildCardHtml(cat, 0)).join('') %>
      </div>
    </div>
  </div>
</div>

<script>
  window._catTree = window._catTree || {}
  window._catTree['<%= secId %>'] = <%- JSON.stringify(catByParent) %>

  function catTreeSelect (secId, slug, level, isLeaf) {
    if (isLeaf) {
      window.location.href = '/' + slug
      return
    }
    var container = document.getElementById(secId)
    if (!container) return

    // remove all levels deeper than current
    var levels = container.querySelectorAll('.category-tree__level')
    levels.forEach(function (el) {
      if (parseInt(el.dataset.level, 10) > level) {
        el.remove()
      }
    })

    // mark active card on current level, deactivate siblings
    var currentLevel = container.querySelector('.category-tree__level[data-level="' + level + '"]')
    if (currentLevel) {
      currentLevel.querySelectorAll('.category-tree__card').forEach(function (btn) {
        btn.classList.remove('active')
      })
      var clicked = currentLevel.querySelector('[onclick*="\'' + slug + '\'"]')
      if (clicked) clicked.classList.add('active')
    }

    var children = window._catTree[secId][slug]
    if (children && children.length) {
      catTreeRender(secId, slug, children, level + 1)
    } else {
      window.location.href = '/' + slug
    }
  }

  function catTreeRender (secId, parentSlug, cats, level) {
    var container = document.getElementById(secId)
    if (!container) return
    var map = window._catTree[secId]

    var parentCat = null
    Object.keys(map).forEach(function (key) {
      map[key].forEach(function (c) {
        if (c.slug === parentSlug) parentCat = c
      })
    })
    var parentName = parentCat ? parentCat.name : ''

    var hslFromCat = function (cat) {
      var hue = 0
      if (cat._id) {
        hue = parseInt(cat._id.slice(-3), 16) % 360
      } else if (cat.name) {
        hue = (cat.name.charCodeAt(0) * 3) % 360
      }
      return hue
    }

    var cards = cats.map(function (cat) {
      var isLeaf = !map[cat.slug] || map[cat.slug].length === 0
      var initial = (cat.name || '?').charAt(0).toUpperCase()
      var hue = hslFromCat(cat)
      var iconHtml = cat.icon
        ? '<img data-src="' + cat.icon.url + '" alt="' + (cat.icon.alt || cat.name) + '" class="lozad category-tree__icon">'
        : '<div class="category-tree__placeholder" style="background:hsl(' + hue + ',55%,50%)">' + initial + '</div>'
      return '<div class="col-6 col-md-4 col-lg-3 mb-2">' +
        '<button class="category-tree__card d-flex align-items-center w-100" ' +
          'onclick="catTreeSelect(\'' + secId + '\',\'' + cat.slug + '\',' + level + ',' + isLeaf + ')" ' +
          'type="button" aria-label="' + cat.name + '">' +
          '<span class="category-tree__img-wrap flex-shrink-0">' + iconHtml + '</span>' +
          '<span class="category-tree__name">' + cat.name + '</span>' +
        '</button>' +
      '</div>'
    }).join('')

    var levelDiv = document.createElement('div')
    levelDiv.className = 'category-tree__level mt-2'
    levelDiv.dataset.level = level
    levelDiv.innerHTML =
      (parentName ? '<div class="category-tree__level-header">' + parentName + '</div>' : '') +
      '<div class="row">' + cards + '</div>'

    container.appendChild(levelDiv)

    // lazy load images in new level
    if (window.lozad) {
      lozad(levelDiv.querySelectorAll('.lozad')).observe()
    }

    // smooth scroll to new level
    levelDiv.scrollIntoView({ behavior: 'smooth', block: 'nearest' })
  }
</script>
<% } %>
