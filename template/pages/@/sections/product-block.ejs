<%
const stamps = _.cms('stamps') || {}
let stampsList
if (stamps && Array.isArray(stamps.stamps_list) && stamps.stamps_list.length) {
  stampsList = stamps.stamps_list
}
%>

<div id="product-block" class="product-block mt-md-3 mb-4 mb-lg-5">
  <div class="container">
    <section
      id="product"
      class="product"
      data-to-render="true"
      data-product-id="<%= _.state._id %>"
      data-sku="<%= _.state.sku %>"
    >
      <div id="product-dock">
        <!--
          `TheProduct` should be rendered (hydrated) here:
          https://developers.e-com.plus/storefront/@ecomplus/storefront-components/docs/TheProduct.html
        -->
      </div>

      <div class="row">
        <div class="col-12 col-md-7 mb-4">
          <!-- Picture(s) gallery will be inserted dynamically within `TheProduct` -->
          <% if (_.state.pictures) { %>
            <% const imgObj = _.ecomUtils.img(_.state, null, 'big') %>
            <% if (imgObj) { %>
              <% const [width, height] = (imgObj.size || '').split('x').map(px => parseInt(px, 10)) %>
              <div id="product-gallery">
                <div data-slot="stamps">
                  <% if (Array.isArray(stampsList) && stampsList.length) { %>
                    <div class="product__stamps">
                      <% for (stamp of stampsList) { 
                        if (stamp.img && (!stamp.skus || !stamp.skus.length || stamp.skus.includes(_.state.sku))) {
                          %>
                          <span class="product__stamps-<%= stamp.id && stamp.id.toLowerCase().replace(/\s/g, '-') %>">
                            <img src="<%= stamp.img %>" alt="<%= stamp.id %>">
                          </span>
                        <% } %>
                      <% } %>
                    </div>
                  <% } %>
                </div>
                <div
                  class="product__picture"
                  <% if (width) { %>
                    style="max-width: <%= width %>px"
                  <% } %>  
                >
                  <picture
                    <% if (width && height) { %>
                      class="picture"
                      style="--aspect-ratio-pc: <%= Math.round(height * 100 * 10000 / width) / 10000 %>%"
                    <% } %>
                  >
                    <source
                      srcset="<%= _.ecomUtils.img(_.state).url %>"
                      type="image/webp"
                      media="(max-width: 399.98px)"
                    >
                    <source
                      srcset="<%= imgObj.url %>"
                      type="image/webp"
                      media="(min-width: 400px)"
                    >
                    <img
                      src="<%= imgObj.url.replace(/\.webp$/, '') %>"
                      alt="<%= imgObj.alt || _.state.name %>"
                      <% if (imgObj.url.startsWith('https://ecoms1.com/')) { %>
                        crossorigin="anonymous"
                      <% } %>
                      <% if (height) { %>
                        width="<%= width %>"
                        height="<%= height %>"
                      <% } %>
                    >
                  </picture>
                </div>
              </div>
            <% } %>
          <% } %>
          <!-- Custom additional code on bottom of images gallery -->
        </div>

        <div class="col-md-5">
          <div class="sticky-this">
          <h1 class="product__name">
            <%= _.ecomUtils.name(_.state) %>
          </h1>
          <p class="product__sku">
            COD: <%= _.state.sku %>
          </p>

          <div id="product-actions">
            <div id="product-loading">
              <% if (_.state.available && _.state.visible && _.ecomUtils.inStock(_.state)) { %>
                <div class="product__price prices prices--big">
                  <strong class="prices__value">
                    <%= _.ecomUtils.formatMoney(_.ecomUtils.price(_.state)) %>
                  </strong>
                </div>
              <% } %>

              <% if (_.state.variations && _.state.variations.length) { %>
                <div data-slot="variations-info">
                  <!-- Custom info for products with variations, such as sizes table link -->
                  <% if (opt.size_guide && opt.size_guide.image) { %>
                    <% const sizeGuideTitle = opt.size_guide.title || _.dictionary('sizeGuide') %>
                    <div class="mb-3">
                      <a 
                        href="javascript:;"
                        data-toggle="modal"
                        data-target="#modal-size-guide"
                      >
                        <i class="i-ruler mr-1"></i> <%= sizeGuideTitle %>
                      </a>
                    </div>
                  <% } %>
                </div>
              <% } %>

              <div class="spinner-border m-4" role="status">
                <span class="sr-only">Loading...</span>
              </div>

              <div class="product__buy">
                <button
                  type="button"
                  class="btn btn-lg btn-primary"
                  onclick="ecomCart.addProduct(storefront.context.body)"
                  <% if (_.state.variations && _.state.variations.length) { %>
                    disabled
                  <% } %>
                >
                  <div data-slot="buy-button-content">
                    
                    <% if (_.state.kit_composition && _.state.kit_composition.length) { %>
                      <%= _.dictionary('buyKit') %>
                    <% } else { %> 
                      <% let buyText %>
                      <% if (Array.isArray(_.widgets)) { %>
                        <% const productWidget = _.widgets.find(item => item.pkg === '@ecomplus/widget-product') %>
                        <% buyText = productWidget && productWidget.options.buyText %>
                      <% } %>
                      <%= buyText || _.dictionary('buy') %>
                    <% } %>
                  </div>
                </button>
              </div>
            </div>
          </div>

          
          </div>
        </div>
      </div>

      <%# Modal do guia de tamanhos: renderizado fora de `.sticky-this`. O link
          gatilho fica dentro do painel e aciona por id (#modal-size-guide).
          Mantê-lo fora também o deixa imune a qualquer offset aplicado ao painel. %>
      <% if (opt.size_guide && opt.size_guide.image) { %>
        <% const sizeGuideTitle = opt.size_guide.title || _.dictionary('sizeGuide') %>
        <div
          class="modal modal-center fade"
          id="modal-size-guide"
          tabindex="-1"
          style="display: none;"
          aria-hidden="true"
        >
          <div class="modal-dialog">
            <div class="modal-content">
              <div class="modal-header d-flex align-items-center justify-content-between">
                <h5 class="modal-title">
                  <%= sizeGuideTitle %>
                </h5>
                <button type="button" class="close" data-dismiss="modal">
                  <span aria-hidden="true">&times;</span>
                </button>
              </div>
              <div class="modal-body">
                <img
                  class="img-fluid"
                  src="<%= opt.size_guide.image %>"
                  alt="<%= sizeGuideTitle %>"
                >
              </div>
            </div>
          </div>
        </div>
      <% } %>

      <%- await include('@/helpers/widgets-append', {
        _, opt: {}, field: 'productSlots'
      }) %>
    </section>

    <%- await include('@/helpers/widgets-append', {
      _, opt: {}, field: 'productBlockAppend'
    }) %>
  </div>
</div>
<script>
  (function () {
    // Sticky-sidebar direcional (estilo adidas / react-sticky-box).
    //
    // O painel fica SEMPRE `position: sticky` e NUNCA troca de borda — o que
    // evita o "pulo". O comportamento direcional vem de deslizar continuamente
    // o offset `top` do sticky conforme a rolagem:
    //   - DESCENDO: o painel acompanha a página subindo até a base encostar no
    //     fim da tela, e então fica fixo pela base.
    //   - SUBINDO:  solta e acompanha a página descendo até o topo alcançar a
    //     posição ideal, e então fica fixo pelo topo.
    //
    // Como controlamos `R` (posição do topo do painel em coords do documento)
    // sempre dentro das duas "linhas de fixação", o `top` calculado coincide
    // com a posição natural exatamente nas bordas -> transição contínua, sem
    // pulo. É um único elemento sticky sendo reposicionado (barato) e NENHUMA
    // leitura de layout no scroll (as medidas ficam em cache) -> sem "truncar".
    var MOBILE_BREAKPOINT = 990 // abaixo disso, sticky desativado (ver SCSS)
    var GAP = 20 // respiro abaixo do painel quando fixado pela base
    var FALLBACK_HEADER_OFFSET = 120

    var el = null
    var mode = null       // 'native' (curto) | 'follow' (alto) | null (mobile/off)
    var m = null          // medidas em cache (recalc. só em resize/observer)
    var R = null          // posição (doc) da borda superior do painel
    var lastY = window.pageYOffset || 0
    var ticking = false

    function getEl () {
      if (!el) el = document.querySelector('#product-block .sticky-this')
      return el
    }

    function getHeaderOffset () {
      var header = document.getElementById('header')
      return header ? header.offsetHeight + 16 : FALLBACK_HEADER_OFFSET
    }

    function reset (node) {
      node.style.position = ''
      node.style.top = ''
      node.style.bottom = ''
      node.style.transform = ''
      node.style.willChange = ''
    }

    // Caro: lê o layout. Chamado SÓ quando algo muda de tamanho, nunca no scroll.
    function measure () {
      var node = getEl()
      if (!node) { mode = null; m = null; return }

      if (window.innerWidth <= MOBILE_BREAKPOINT) {
        reset(node)
        mode = null
        m = null
        R = null
        return
      }

      var parent = node.parentElement
      var scrollY = window.pageYOffset || 0
      var topSpacing = getHeaderOffset()
      var eh = node.offsetHeight
      var vh = window.innerHeight

      // limpa resquícios de tentativas anteriores (transform/bottom) e fixa sticky
      node.style.transform = ''
      node.style.willChange = ''
      node.style.bottom = 'auto'
      node.style.position = 'sticky'

      if (eh + topSpacing + GAP <= vh) {
        // ── Painel curto: sticky-top nativo fixo (sem JS no scroll) ──
        mode = 'native'
        m = null
        R = null
        node.style.top = topSpacing + 'px'
        return
      }

      // ── Painel alto: follow direcional ──
      mode = 'follow'
      m = {
        trackTop: parent.getBoundingClientRect().top + scrollY, // topo da coluna (doc)
        trackH: parent.offsetHeight,
        eh: eh,
        topSpacing: topSpacing,
        vh: vh
      }
      // NÃO zera R aqui: preserva a posição entre remedições (ResizeObserver na
      // hidratação) para não dar salto. Só inicializa quando ainda é null.
      position(scrollY)
    }

    // Barato: só no scroll (modo follow). Lê apenas scrollY; sem leitura de layout.
    function position (scrollY) {
      if (mode !== 'follow' || !m) return
      var minR = m.trackTop
      var maxR = m.trackTop + m.trackH - m.eh
      if (maxR < minR) maxR = minR // painel mais alto que a coluna: sem trilho

      var topLine = scrollY + m.topSpacing            // R que fixa o topo
      var bottomLine = scrollY + m.vh - GAP - m.eh     // R que fixa a base
      if (R === null) R = topLine

      if (scrollY > lastY) {
        // descendo: R sobe (acompanha) até no máximo a linha da base
        if (R < bottomLine) R = bottomLine
      } else if (scrollY < lastY) {
        // subindo: R desce (acompanha) até no mínimo a linha do topo
        if (R > topLine) R = topLine
      }

      if (R < minR) R = minR
      if (R > maxR) R = maxR
      lastY = scrollY

      // `top` do sticky = posição desejada relativa à viewport. Como R está
      // sempre entre as linhas, o elemento permanece "grudado" e renderiza
      // exatamente em R - sem reflow da página, sem pulo.
      el.style.top = (R - scrollY) + 'px'
    }

    function onScroll () {
      if (ticking || mode !== 'follow') return
      ticking = true
      window.requestAnimationFrame(function () {
        ticking = false
        position(window.pageYOffset || 0)
      })
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', measure)
    } else {
      measure()
    }
    window.addEventListener('scroll', onScroll, { passive: true })
    window.addEventListener('resize', measure)
    window.addEventListener('load', measure)

    // o conteúdo do painel hidrata de forma assíncrona (TheProduct: preço,
    // variações, etc.), então remede sempre que a altura mudar
    if (window.ResizeObserver) {
      var node = getEl()
      if (node) {
        var ro = new ResizeObserver(measure)
        ro.observe(node)
        if (node.parentElement) ro.observe(node.parentElement)
      }
    }
  })()
</script>
<%
const productJsonLd = {
  '@context': 'http://schema.org',
  '@type': 'Product',
  sku: _.state.sku,
  description: _.state.short_description || _.state.meta_description || _.ecomUtils.name(_.state),
  name: _.ecomUtils.name(_.state),
  offers: {
    '@type': 'Offer',
    url: `https://${_.settings.domain}/${_.state.slug}`,
    availability: `${(_.ecomUtils.inStock(_.state) ? 'In' : 'OutOf')}Stock`,
    priceCurrency: _.settings.currency,
    price: _.ecomUtils.price(_.state),
    itemCondition: `http://schema.org/${(_.state.condition === 'new' ? 'New' : 'Used')}Condition`,
    priceValidUntil: _.ecomUtils.onPromotion(_.state) && _.state.price_effective_date && _.state.price_effective_date.end
      ? _.state.price_effective_date.end.slice(0, 10)
      : undefined,
    seller: {
      '@type': 'Organization',
      name: _.settings.name || _.store.name
    }
  }
}
if (_.state.brands && _.state.brands[0]) {
  productJsonLd.brand = {
    '@type': 'Brand',
    name: _.state.brands[0].name
  }
}
if (_.state.pictures && _.state.pictures.length) {
  productJsonLd.image = _.ecomUtils.img(_.state, null, 'zoom').url
    .replace(/(\w+\.)?(ecoms\d)\.com/i, '$2-nyc3.nyc3.cdn.digitaloceanspaces.com')
}
if (_.state.mpn && _.state.mpn[0]) {
  productJsonLd.mpn = _.state.mpn[0]
}
if (_.state.gtin && _.state.gtin[0]) {
  productJsonLd.gtin = _.state.gtin[0]
}
%>
<script id="product-block-jsonld" type="application/ld+json"><%-
  JSON.stringify(productJsonLd)
%></script>
<script type="text/javascript">
  setTimeout(() => {
    const urlParams = new URLSearchParams(window.location.search);
    const variationId = urlParams.get('variation_id');
    const variations = window._context.body && window._context.body.variations;
    if (Array.isArray(variations) && variationId) {
      const selectedVariation = variations.find(variation => variation._id === variationId);
      if (selectedVariation) {
        const $jsonLd = document.querySelector('#product-block-jsonld');
        const jsonLd = JSON.parse($jsonLd.innerText);
        jsonLd.sku = selectedVariation.sku;
        jsonLd.offers.price = selectedVariation.price;
        jsonLd.name = (selectedVariation.name && selectedVariation.name.replace('"', '')) || jsonLd.name;
        jsonLd.offers.url = `${jsonLd.offers.url}?variation_id=${variationId}`;
        document.querySelector('#product-block-jsonld').innerText = JSON.stringify(jsonLd);
      }
    }
  }, 50);
</script>
