<% if (_.state.body_html || _.state.specifications) { %>
  <section id="product-description" class="product-description my-4 my-lg-5">
    <div class="container">

      <ul class="nav nav-tabs product-description__tabs" id="productInfoTabs" role="tablist">
        <% if (_.state.body_html) { %>
          <li class="nav-item" role="presentation">
            <a
              class="nav-link<% if (_.state.body_html) { %> active<% } %>"
              id="tab-description"
              data-toggle="tab"
              href="#pane-description"
              role="tab"
              aria-controls="pane-description"
              aria-selected="<%= !!_.state.body_html %>"
            >
              <%= _.dictionary('productDescription') %>
            </a>
          </li>
        <% } %>
        <% if (_.state.specifications) { %>
          <li class="nav-item" role="presentation">
            <a
              class="nav-link<% if (!_.state.body_html) { %> active<% } %>"
              id="tab-specs"
              data-toggle="tab"
              href="#pane-specs"
              role="tab"
              aria-controls="pane-specs"
              aria-selected="<%= !_.state.body_html %>"
            >
              Especificações
            </a>
          </li>
        <% } %>
      </ul>

      <div class="tab-content product-description__content pt-4" id="productInfoTabsContent">
        <% if (_.state.body_html) { %>
          <div
            class="tab-pane fade show active"
            id="pane-description"
            role="tabpanel"
            aria-labelledby="tab-description"
          >
            <div class="html-clearfix">
              <%- _.state.body_html.replace(
                /<img ([^/>]+)?src=['"]([^'"]+)['"]([^/>]+)?\/?>/g,
                '<img class="lozad" data-src="$2" $1 $3>'
              ).replace(
                /<img class="lozad" data-src="([^'"]+)"([^>]+)class=['"]([^'"]+)['"]([^/>]+)?>/g,
                '<img class="lozad $3" data-src="$1" $2 $4>'
              ) %>
            </div>
          </div>
        <% } %>
        <% if (_.state.specifications) { %>
          <div
            class="tab-pane fade<% if (!_.state.body_html) { %> show active<% } %>"
            id="pane-specs"
            role="tabpanel"
            aria-labelledby="tab-specs"
          >
            <table class="table table-striped">
              <tbody>
                <% for (const gridId in _.state.specifications) {
                  if (_.state.specifications[gridId]) {
                    %>
                    <tr>
                      <td class="text-muted">
                        <%= _.ecomUtils.gridTitle(gridId, _.grids) %>
                      </td>
                      <td>
                        <%= _.ecomUtils.specTextValue(_.state, gridId, _.grids) %>
                      </td>
                    </tr>
                    <%
                  }
                } %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

    </div>
  </section>
<% } %>


<%- await include('@/helpers/widgets-append', {
  _, opt: {}, field: 'productDescriptionAppend'
}) %>
